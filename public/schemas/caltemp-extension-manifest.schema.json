{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caltemp.app/schemas/caltemp-extension-manifest.schema.json",
  "title": "Caltemp Extension Manifest",
  "description": "SDK 2.0. Only id, name and version are required; a manifest with a theme block is a theme, anything else a plugin.",
  "type": "object",
  "required": ["id", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+[a-z0-9]$"
    },
    "name": { "type": "string", "minLength": 1 },
    "type": { "enum": ["plugin", "theme"], "description": "Inferred when omitted." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
    "sdkVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+", "default": "2.0.0" },
    "compatibility": {
      "type": "object",
      "properties": {
        "caltemp": { "type": "string", "default": ">=6.0.0" }
      }
    },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "homepage": { "type": "string" },
    "repository": { "type": "string" },
    "changelog": { "type": "string" },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "calendar:read",
          "calendar:write",
          "settings:read",
          "notifications:send",
          "network",
          "storage:extension",
          "network:github"
        ]
      },
      "uniqueItems": true,
      "description": "storage:extension and network:github are accepted for SDK 1.x manifests and grant nothing."
    },
    "hosts": {
      "type": "array",
      "description": "Domains reachable through ctx.http.fetch (HTTPS). Requires the network permission. '*.example.com' matches subdomains.",
      "items": { "type": "string", "pattern": "^(\\*\\.)?[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
      "uniqueItems": true
    },
    "entry": { "type": "string", "default": "index.js", "pattern": "^[A-Za-z0-9_.-]+\\.m?js$" },
    "settings": {
      "type": "array",
      "description": "User settings rendered in Settings › Extensions and read with ctx.config.get(key).",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
          "type": { "enum": ["string", "number", "boolean", "select"], "default": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "default": {},
          "min": { "type": "number" },
          "max": { "type": "number" },
          "options": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["value"],
                  "properties": { "value": { "type": "string" }, "label": { "type": "string" } }
                }
              ]
            }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "description": "Shorthand: { \"accent\": \"#f00\" } sets --caltemp-accent.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": { "type": "string" }
        },
        "variables": {
          "type": "object",
          "propertyNames": { "pattern": "^--" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
